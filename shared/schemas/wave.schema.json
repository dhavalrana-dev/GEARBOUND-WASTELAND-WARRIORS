{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/wave.schema.json",
  "title": "Gearbound wave definition",
  "type": "object",
  "required": ["schemaVersion", "missionId", "waves"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "groups", "rewardScrap"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rewardScrap": { "type": "integer", "minimum": 0 },
          "boss": { "type": "boolean" },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["enemyId", "count", "firstSpawnTick", "intervalTicks", "lanePattern"],
              "properties": {
                "enemyId": { "type": "string", "minLength": 1 },
                "count": { "type": "integer", "minimum": 1 },
                "firstSpawnTick": { "type": "integer", "minimum": 0 },
                "intervalTicks": { "type": "integer", "minimum": 1 },
                "lanePattern": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 2 } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
