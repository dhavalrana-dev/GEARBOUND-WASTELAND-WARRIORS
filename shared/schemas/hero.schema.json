{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/hero.schema.json",
  "title": "Gearbound hero definitions",
  "type": "object",
  "required": ["schemaVersion", "heroes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "heroes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "health", "armor", "damage", "attackRangeMm", "movementMmPerTick", "attackIntervalTicks", "special", "recovery"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "health": { "type": "integer", "minimum": 1 },
          "armor": { "type": "integer", "minimum": 0 },
          "damage": { "type": "integer", "minimum": 1 },
          "attackRangeMm": { "type": "integer", "minimum": 0 },
          "movementMmPerTick": { "type": "integer", "minimum": 0 },
          "attackIntervalTicks": { "type": "integer", "minimum": 1 },
          "special": {
            "type": "object",
            "required": ["id", "name", "spMax", "spPerHit", "damage", "radiusMm"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
              "name": { "type": "string", "minLength": 1 },
              "spMax": { "type": "integer", "minimum": 1 },
              "spPerHit": { "type": "integer", "minimum": 0 },
              "damage": { "type": "integer", "minimum": 1 },
              "radiusMm": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "recovery": {
            "type": "object",
            "description": "A knocked-out hero returns at the fortress line, in the same lane, after `ticks` combat ticks with healthPercent of maximum health (at least 1); a hero who is down when a wave ends recovers at once.",
            "required": ["ticks", "healthPercent"],
            "properties": {
              "ticks": { "type": "integer", "minimum": 1 },
              "healthPercent": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
