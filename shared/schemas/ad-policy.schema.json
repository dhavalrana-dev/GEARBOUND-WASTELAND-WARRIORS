{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/ad-policy.schema.json",
  "title": "Gearbound ad placement policy",
  "type": "object",
  "required": ["schemaVersion", "enabled", "interstitial", "rewardedInterstitial", "rewardedPlacements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enabled": { "type": "boolean" },
    "interstitial": {
      "type": "object",
      "required": ["allowedContexts", "adFreeFirstMissions", "minMissionsBetween", "minSecondsBetween", "maxPerSession", "suppressSecondsAfterRewarded", "disabledByEntitlement"],
      "properties": {
        "allowedContexts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "adFreeFirstMissions": { "type": "integer", "minimum": 3 },
        "minMissionsBetween": { "type": "integer", "minimum": 0 },
        "minSecondsBetween": { "type": "integer", "minimum": 0 },
        "maxPerSession": { "type": "integer", "minimum": 0 },
        "suppressSecondsAfterRewarded": { "type": "integer", "minimum": 0 },
        "disabledByEntitlement": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rewardedInterstitial": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": false
    },
    "rewardedPlacements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reward", "dailyCap", "perMissionCap", "cooldownSeconds", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^rewarded\\.[a-z0-9_]+$" },
          "reward": { "type": "object" },
          "dailyCap": { "type": "integer", "minimum": 0 },
          "perMissionCap": { "type": "integer", "minimum": 0 },
          "cooldownSeconds": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
