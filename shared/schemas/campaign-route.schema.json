{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/campaign-route.schema.json",
  "title": "Gearbound campaign route",
  "type": "object",
  "required": ["schemaVersion", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mission", "waveIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "mission": { "type": "string", "pattern": "^waves/[a-z0-9_]+\\.json$" },
          "waveIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
