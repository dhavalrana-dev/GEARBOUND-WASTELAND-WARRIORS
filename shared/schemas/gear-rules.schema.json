{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/gear-rules.schema.json",
  "title": "Gearbound gear rules",
  "type": "object",
  "required": ["schemaVersion", "board", "simulation", "network", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "board": { "type": "object", "required": ["width", "height", "connectivity", "maxCores"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "connectivity": { "const": "orthogonal-reciprocal-ports" }, "maxCores": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "simulation": { "type": "object", "required": ["ticksPerSecond", "randomAlgorithm"], "properties": { "ticksPerSecond": { "const": 30 }, "randomAlgorithm": { "const": "xorshift32-v1" } }, "additionalProperties": false },
    "network": { "type": "object", "required": ["boosterBonusPercentEach", "boosterBonusPercentCap", "minimumOutputIntervalTicks", "oddParityLoop", "multipleCores"], "properties": { "boosterBonusPercentEach": { "type": "integer", "minimum": 0 }, "boosterBonusPercentCap": { "type": "integer", "minimum": 0 }, "minimumOutputIntervalTicks": { "type": "integer", "minimum": 1 }, "oddParityLoop": { "const": "jam-component" }, "multipleCores": { "const": "disable-component" } }, "additionalProperties": false },
    "output": { "type": "object", "required": ["friendlyUnitCapPerLane", "queuedSpawnsPerOutput"], "properties": { "friendlyUnitCapPerLane": { "type": "integer", "minimum": 1 }, "queuedSpawnsPerOutput": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
