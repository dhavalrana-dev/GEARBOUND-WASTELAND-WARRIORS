{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/currencies.schema.json",
  "title": "Gearbound currencies",
  "type": "object",
  "required": ["schemaVersion", "currencies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "scope", "premium", "max"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["mission", "persistent", "event"] },
          "premium": { "type": "boolean" },
          "max": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
