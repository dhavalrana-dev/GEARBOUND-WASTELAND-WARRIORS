{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearbound.invalid/schemas/progression-rewards.schema.json",
  "title": "Gearbound earn-only progression rewards",
  "type": "object",
  "required": ["schemaVersion", "boosters", "winStreak", "starChests", "loginTrack", "dailyContracts", "weeklyEventTiers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "boosters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "maxStack"],
        "properties": {
          "id": { "type": "string", "pattern": "^booster\\.[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "maxStack": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "winStreak": {
      "type": "object",
      "required": ["name", "maxLevel", "resetOnDefeat", "streakSoldierLaneOrder"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maxLevel": { "type": "integer", "minimum": 1 },
        "resetOnDefeat": { "type": "boolean" },
        "streakSoldierLaneOrder": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 2 } }
      },
      "additionalProperties": false
    },
    "starChests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stars", "scrap", "boosters"],
        "properties": {
          "stars": { "type": "integer", "minimum": 1 },
          "scrap": { "type": "integer", "minimum": 0 },
          "boosters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
        },
        "additionalProperties": false
      }
    },
    "loginTrack": {
      "type": "object",
      "required": ["name", "missedDaysReset", "days"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "missedDaysReset": { "type": "boolean" },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scrap", "boosters"],
            "properties": {
              "scrap": { "type": "integer", "minimum": 0 },
              "boosters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dailyContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "target", "scrapReward"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "target": { "type": "integer", "minimum": 1 },
          "scrapReward": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "weeklyEventTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["points", "scrap"],
        "properties": {
          "points": { "type": "integer", "minimum": 1 },
          "scrap": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
