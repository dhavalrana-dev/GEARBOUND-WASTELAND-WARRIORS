{
  "schemaVersion": 1,
  "description": "Interstitial and rewarded eligibility against shared/monetization/ad_policy.json. Times are seconds since session start.",
  "interstitialCases": [
    { "id": "allowed-after-third-mission", "state": { "context": "mission_complete_transition", "nowSeconds": 600, "missionsCompleted": 4, "missionsSinceLastInterstitial": 4, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": true, "reason": "eligible" } },
    { "id": "first-three-missions-ad-free", "state": { "context": "mission_complete_transition", "nowSeconds": 600, "missionsCompleted": 3, "missionsSinceLastInterstitial": 3, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "ad_free_onboarding" } },
    { "id": "never-during-combat", "state": { "context": "combat", "nowSeconds": 600, "missionsCompleted": 10, "missionsSinceLastInterstitial": 5, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "context_not_allowed" } },
    { "id": "never-during-gear-placement", "state": { "context": "gear_placement", "nowSeconds": 600, "missionsCompleted": 10, "missionsSinceLastInterstitial": 5, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "context_not_allowed" } },
    { "id": "no-ads-entitlement", "state": { "context": "mission_complete_transition", "nowSeconds": 600, "missionsCompleted": 10, "missionsSinceLastInterstitial": 5, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": true, "consentReady": true }, "expect": { "show": false, "reason": "no_ads_entitlement" } },
    { "id": "consent-missing", "state": { "context": "mission_complete_transition", "nowSeconds": 600, "missionsCompleted": 10, "missionsSinceLastInterstitial": 5, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": null, "noAds": false, "consentReady": false }, "expect": { "show": false, "reason": "consent_not_ready" } },
    { "id": "too-few-missions-since-last", "state": { "context": "mission_complete_transition", "nowSeconds": 900, "missionsCompleted": 10, "missionsSinceLastInterstitial": 1, "lastInterstitialSeconds": 100, "interstitialsThisSession": 1, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "mission_spacing" } },
    { "id": "too-soon-since-last", "state": { "context": "mission_complete_transition", "nowSeconds": 279, "missionsCompleted": 10, "missionsSinceLastInterstitial": 2, "lastInterstitialSeconds": 100, "interstitialsThisSession": 1, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "time_spacing" } },
    { "id": "exactly-180-seconds-ok", "state": { "context": "mission_complete_transition", "nowSeconds": 280, "missionsCompleted": 10, "missionsSinceLastInterstitial": 2, "lastInterstitialSeconds": 100, "interstitialsThisSession": 1, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": true, "reason": "eligible" } },
    { "id": "session-cap", "state": { "context": "mission_complete_transition", "nowSeconds": 5000, "missionsCompleted": 20, "missionsSinceLastInterstitial": 3, "lastInterstitialSeconds": 1000, "interstitialsThisSession": 4, "lastRewardedSeconds": null, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "session_cap" } },
    { "id": "suppressed-after-rewarded", "state": { "context": "mission_complete_transition", "nowSeconds": 700, "missionsCompleted": 10, "missionsSinceLastInterstitial": 5, "lastInterstitialSeconds": null, "interstitialsThisSession": 0, "lastRewardedSeconds": 600, "noAds": false, "consentReady": true }, "expect": { "show": false, "reason": "recent_rewarded" } }
  ],
  "rewardedCases": [
    { "id": "daily-cap-not-reached", "placement": "rewarded.daily_supply", "state": { "usedToday": 2, "usedThisMission": 0, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": true }, "expect": { "eligible": true, "reason": "eligible" } },
    { "id": "daily-cap-reached", "placement": "rewarded.daily_supply", "state": { "usedToday": 3, "usedThisMission": 0, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": true }, "expect": { "eligible": false, "reason": "daily_cap" } },
    { "id": "per-mission-cap", "placement": "rewarded.victory_double", "state": { "usedToday": 9, "usedThisMission": 1, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": true }, "expect": { "eligible": false, "reason": "mission_cap" } },
    { "id": "unlimited-daily-when-cap-zero", "placement": "rewarded.victory_double", "state": { "usedToday": 50, "usedThisMission": 0, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": true }, "expect": { "eligible": true, "reason": "eligible" } },
    { "id": "unknown-placement", "placement": "rewarded.nope", "state": { "usedToday": 0, "usedThisMission": 0, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": true }, "expect": { "eligible": false, "reason": "unknown_placement" } },
    { "id": "rewarded-needs-consent", "placement": "rewarded.daily_supply", "state": { "usedToday": 0, "usedThisMission": 0, "lastUsedSeconds": null, "nowSeconds": 100, "consentReady": false }, "expect": { "eligible": false, "reason": "consent_not_ready" } }
  ]
}
